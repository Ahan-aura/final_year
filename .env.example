# Self-Evolving Agentic AI Workbench Environment
PROJECT_NAME=Self-Evolving-Agentic-AI-Workbench
ENVIRONMENT=development
PORT=8000
HOST=127.0.0.1

# LLM Configuration
# Provide your Gemini API key (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_MODEL=gemini-flash-latest
FALLBACK_TO_DETERMINISTIC_SYNTHESIZER=false

# Sandbox Safety Limits
SANDBOX_TIMEOUT_SECONDS=5
MAX_EXECUTION_MEMORY_MB=256
ALLOW_SHARED_SKILL_REPO=true
